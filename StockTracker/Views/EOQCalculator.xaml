<UserControl x:Class="StockTracker.Views.EOQCalculator"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:StockTracker.Views"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1400">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title -->
            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="Economic Order Quantity (EOQ) Calculator" FontSize="24" FontWeight="Bold" Foreground="#1976D2"/>
                <TextBlock Text="Calculate the optimal order quantity to minimize total inventory costs" FontSize="12" Foreground="#555" Margin="0,5,0,0"/>
            </StackPanel>

            <!-- Phase 1: Annual Demand -->
            <Border Grid.Row="1" BorderBrush="#DDD" BorderThickness="1" Padding="20" Margin="0,0,0,15" Background="#F9F9F9">
                <StackPanel>
                    <TextBlock Text="Phase 1: Annual Demand" FontSize="18" FontWeight="Bold" Foreground="#1976D2" Margin="0,0,0,15"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Demand Input -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Demand Quantity:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,5"/>
                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="5">
                            <TextBox x:Name="DemandQuantityInput" Width="150" Padding="5" TextChanged="DemandInput_TextChanged"/>
                            <ComboBox x:Name="DemandPeriodInput" Width="150" Margin="10,0,0,0" SelectedIndex="3" SelectionChanged="DemandInput_TextChanged">
                                <ComboBoxItem Content="Daily"/>
                                <ComboBoxItem Content="Weekly"/>
                                <ComboBoxItem Content="Monthly"/>
                                <ComboBoxItem Content="Annually"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- Calculated Annual Demand -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Annual Demand:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,15,0,5"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="AnnualDemandDisplay" Text="0 units" FontSize="16" FontWeight="Bold" Foreground="#2E7D32" Margin="5,15,5,5" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Phase 2: Ordering Costs -->
            <Border Grid.Row="2" BorderBrush="#DDD" BorderThickness="1" Padding="20" Margin="0,0,0,15" Background="#F9F9F9">
                <StackPanel>
                    <TextBlock Text="Phase 2: Ordering Costs per Order" FontSize="18" FontWeight="Bold" Foreground="#1976D2" Margin="0,0,0,10"/>
                    <TextBlock Text="Add all costs associated with placing a single order" FontSize="12" Foreground="#555" Margin="0,0,0,15"/>

                    <!-- Add Cost Button -->
                    <Button Content="+ Add Ordering Cost" Click="AddOrderingCost_Click" Padding="10,5" Width="150" HorizontalAlignment="Left" Margin="0,0,0,10"/>

                    <!-- Ordering Costs DataGrid -->
                    <DataGrid x:Name="OrderingCostsGrid"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="All"
                              MinHeight="100"
                              MaxHeight="250"
                              Margin="0,0,0,10">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" MinWidth="200"/>
                            <DataGridTextColumn Header="Cost (R)" Binding="{Binding Cost, StringFormat=N2}" Width="150"/>
                            <DataGridTemplateColumn Header="Actions" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Remove" Click="RemoveOrderingCost_Click" Padding="5,2" Tag="{Binding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Total Ordering Cost -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,0,0">
                        <TextBlock Text="Total Ordering Cost per Order:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock x:Name="TotalOrderingCostDisplay" Text="R 0.00" FontSize="16" FontWeight="Bold" Foreground="#2E7D32" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Phase 3: Holding Costs -->
            <Border Grid.Row="3" BorderBrush="#DDD" BorderThickness="1" Padding="20" Margin="0,0,0,15" Background="#F9F9F9">
                <StackPanel>
                    <TextBlock Text="Phase 3: Holding Costs per Unit per Year" FontSize="18" FontWeight="Bold" Foreground="#1976D2" Margin="0,0,0,10"/>
                    <TextBlock Text="Add all costs associated with holding one unit in inventory for one year" FontSize="12" Foreground="#555" Margin="0,0,0,15"/>

                    <!-- Add Cost Button -->
                    <Button Content="+ Add Holding Cost" Click="AddHoldingCost_Click" Padding="10,5" Width="150" HorizontalAlignment="Left" Margin="0,0,0,10"/>

                    <!-- Holding Costs DataGrid -->
                    <DataGrid x:Name="HoldingCostsGrid"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="All"
                              MinHeight="100"
                              MaxHeight="250"
                              Margin="0,0,0,10">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" MinWidth="200"/>
                            <DataGridTextColumn Header="Cost (R)" Binding="{Binding Cost, StringFormat=N2}" Width="150"/>
                            <DataGridTemplateColumn Header="Actions" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Remove" Click="RemoveHoldingCost_Click" Padding="5,2" Tag="{Binding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Total Holding Cost -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,0,0">
                        <TextBlock Text="Total Holding Cost per Unit per Year:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock x:Name="TotalHoldingCostDisplay" Text="R 0.00" FontSize="16" FontWeight="Bold" Foreground="#2E7D32" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Phase 4: Reorder Level -->
            <Border Grid.Row="4" BorderBrush="#DDD" BorderThickness="1" Padding="20" Margin="0,0,0,15" Background="#F9F9F9">
                <StackPanel>
                    <TextBlock Text="Phase 4: Reorder Level" FontSize="18" FontWeight="Bold" Foreground="#1976D2" Margin="0,0,0,10"/>
                    <TextBlock Text="Determine when to place a new order based on maximum usage and lead time" FontSize="12" Foreground="#555" Margin="0,0,0,15"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Time Period Selection -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Time Period:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,5"/>
                        <ComboBox Grid.Row="0" Grid.Column="1" x:Name="LeadTimePeriodInput" Width="150" Margin="5" HorizontalAlignment="Left" SelectedIndex="0" SelectionChanged="ReorderInput_TextChanged">
                            <ComboBoxItem Content="Days"/>
                            <ComboBoxItem Content="Weeks"/>
                            <ComboBoxItem Content="Months"/>
                        </ComboBox>

                        <!-- Maximum Usage -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Maximum Usage:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,10,0,5"/>
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="5,10,5,5">
                            <TextBox x:Name="MaxUsageInput" Width="150" Padding="5" TextChanged="ReorderInput_TextChanged"/>
                            <TextBlock x:Name="MaxUsagePeriodLabel" Text="units per day" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>

                        <!-- Maximum Lead Time -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Maximum Lead Time:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,10,0,5"/>
                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="5,10,5,5">
                            <TextBox x:Name="MaxLeadTimeInput" Width="150" Padding="5" TextChanged="ReorderInput_TextChanged"/>
                            <TextBlock x:Name="MaxLeadTimePeriodLabel" Text="days" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>

                        <!-- Calculated Reorder Level -->
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Reorder Level:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,15,0,5"/>
                        <StackPanel Grid.Row="3" Grid.Column="1" Margin="5,15,5,5">
                            <TextBlock x:Name="ReorderLevelDisplay" Text="0 units" FontSize="16" FontWeight="Bold" Foreground="#2E7D32" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ReorderFormulaDisplay" Text="Formula: Maximum Usage × Maximum Lead Time" FontSize="11" FontStyle="Italic" Foreground="#666" Margin="0,5,0,0" TextWrapping="Wrap"/>
                            <TextBlock x:Name="LeadTimeInDaysDisplay" Text="" FontSize="11" FontStyle="Italic" Foreground="#888" Margin="0,3,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Calculate Button -->
            <Button Grid.Row="5" Content="Calculate EOQ" Click="CalculateEOQ_Click" Padding="20,10" FontSize="16" FontWeight="Bold" Background="#1976D2" Foreground="White" HorizontalAlignment="Center" Margin="0,10,0,20"/>

            <!-- Results Display -->
            <Border Grid.Row="6" x:Name="ResultsPanel" Visibility="Collapsed" BorderBrush="#1976D2" BorderThickness="2" Padding="25" Background="#E3F2FD">
                <StackPanel>
                    <TextBlock Text="EOQ Calculation Results" FontSize="20" FontWeight="Bold" Foreground="#1976D2" Margin="0,0,0,20" HorizontalAlignment="Center"/>

                    <!-- Formula Display -->
                    <Border BorderBrush="#DDD" BorderThickness="1" Padding="15" Background="White" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="EOQ Formula Used:" FontWeight="Bold" Margin="0,0,0,10"/>
                            <TextBlock x:Name="FormulaDisplay" Text="EOQ = √(2 × D × S / H)" FontSize="14" FontFamily="Courier New" Foreground="#555" TextWrapping="Wrap"/>
                            <TextBlock x:Name="FormulaValuesDisplay" Text="" FontSize="12" FontFamily="Courier New" Foreground="#666" Margin="0,10,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- EOQ Result -->
                    <Border BorderBrush="#2E7D32" BorderThickness="2" Padding="20" Background="#E8F5E9" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="Economic Order Quantity (EOQ):" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBlock x:Name="EOQResultDisplay" Text="0" FontSize="36" FontWeight="Bold" Foreground="#2E7D32" HorizontalAlignment="Center"/>
                            <TextBlock Text="units per order" FontSize="14" Foreground="#555" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Reorder Level Result -->
                    <Border x:Name="ReorderLevelResultPanel" Visibility="Collapsed" BorderBrush="#FF6F00" BorderThickness="2" Padding="20" Background="#FFF3E0" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="Reorder Level:" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                            <TextBlock x:Name="ReorderLevelResultDisplay" Text="0" FontSize="32" FontWeight="Bold" Foreground="#FF6F00" HorizontalAlignment="Center"/>
                            <TextBlock Text="units" FontSize="14" Foreground="#555" HorizontalAlignment="Center" Margin="0,5,0,10"/>
                            <TextBlock x:Name="ReorderFormulaResultDisplay" Text="" FontSize="12" FontFamily="Courier New" Foreground="#666" HorizontalAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Additional Insights -->
                    <Border BorderBrush="#DDD" BorderThickness="1" Padding="15" Background="White">
                        <StackPanel>
                            <TextBlock Text="Additional Insights:" FontWeight="Bold" Margin="0,0,0,10"/>
                            <StackPanel x:Name="InsightsPanel">
                                <!-- Insights will be added dynamically -->
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>