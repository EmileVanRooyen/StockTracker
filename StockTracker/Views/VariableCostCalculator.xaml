<UserControl x:Class="StockTracker.Views.FixedCostPortionCalculator"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:StockTracker.Views"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1400">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title -->
            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="Fixed Cost Portion Calculator" FontSize="24" FontWeight="Bold" Foreground="#1976D2"/>
                <TextBlock Text="Enter multiple unit and cost price entries to calculate the fixed cost portion and variable cost per unit" 
                           FontSize="12" Foreground="#555" Margin="0,5,0,0" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- Data Entry Section -->
            <Border Grid.Row="1" BorderBrush="#DDD" BorderThickness="1" Padding="20" Margin="0,0,0,15" Background="#F9F9F9">
                <StackPanel>
                    <TextBlock Text="Cost Data Entries" FontSize="18" FontWeight="Bold" Foreground="#1976D2" Margin="0,0,0,10"/>
                    <TextBlock Text="Add at least 2 entries with different unit quantities and their corresponding total cost prices" 
                               FontSize="12" Foreground="#555" Margin="0,0,0,15"/>

                    <!-- Action Buttons -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="+ Add Entry" Click="AddEntry_Click" Padding="10,5" Margin="0,0,10,0"
                                Background="#1976D2" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#1976D2"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#1565C0"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="Remove Selected" Click="RemoveEntry_Click" Padding="10,5" Margin="0,0,10,0"
                                Background="#D32F2F" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#D32F2F"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#C62828"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="Calculate" Click="Calculate_Click" Padding="10,5"
                                Background="#388E3C" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#388E3C"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#2E7D32"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>

                    <!-- Data Grid -->
                    <DataGrid x:Name="CostDataGrid"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              SelectionMode="Single"
                              GridLinesVisibility="All"
                              RowBackground="White"
                              AlternatingRowBackground="#F5F5F5"
                              HeadersVisibility="Column"
                              MinHeight="150"
                              MaxHeight="300"
                              Margin="0,0,0,10">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Entry #" Binding="{Binding EntryNumber}" Width="80" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Foreground" Value="#1976D2"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Units (Q)" Binding="{Binding Units, UpdateSourceTrigger=PropertyChanged}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Padding" Value="5"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Total Cost Price (R)" Binding="{Binding TotalCostPrice, StringFormat=N2, UpdateSourceTrigger=PropertyChanged}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Padding" Value="5"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- Fixed Cost Portion Results -->
            <Border Grid.Row="2" BorderBrush="#4CAF50" BorderThickness="2" Padding="20" Margin="0,0,0,15" Background="#E8F5E9" Visibility="{Binding ElementName=FixedCostPortionPanel, Path=Visibility}">
                <StackPanel x:Name="FixedCostPortionPanel" Visibility="Collapsed">
                    <TextBlock Text="Fixed Cost Portion" FontSize="18" FontWeight="Bold" Foreground="#2E7D32" Margin="0,0,0,15"/>

                    <!-- Formula Display -->
                    <Border Background="White" Padding="15" Margin="0,0,0,15" BorderBrush="#4CAF50" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Formula:" FontWeight="Bold" FontSize="14" Foreground="#2E7D32" Margin="0,0,0,5"/>
                            <TextBlock x:Name="FixedCostFormulaText" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" Foreground="#333"/>
                            <TextBlock Text="Using High-Low Method:" FontStyle="Italic" FontSize="11" Foreground="#666" Margin="0,10,0,5"/>
                            <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#666">
                                <Run Text="Fixed Cost = Total Cost at High Activity - (Variable Cost per Unit × High Activity Units)"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Result Display -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                        <TextBlock Text="Fixed Cost Portion = " FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock x:Name="FixedCostPortionResult" Text="R 0.00" FontSize="20" FontWeight="Bold" Foreground="#2E7D32" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Variable Cost Per Unit Results -->
            <Border Grid.Row="3" BorderBrush="#2196F3" BorderThickness="2" Padding="20" Margin="0,0,0,15" Background="#E3F2FD" Visibility="{Binding ElementName=VariableCostPanel, Path=Visibility}">
                <StackPanel x:Name="VariableCostPanel" Visibility="Collapsed">
                    <TextBlock Text="Variable Cost Per Unit" FontSize="18" FontWeight="Bold" Foreground="#1565C0" Margin="0,0,0,15"/>

                    <!-- Formula Display -->
                    <Border Background="White" Padding="15" Margin="0,0,0,15" BorderBrush="#2196F3" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Formula:" FontWeight="Bold" FontSize="14" Foreground="#1565C0" Margin="0,0,0,5"/>
                            <TextBlock x:Name="VariableCostFormulaText" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" Foreground="#333"/>
                            <TextBlock Text="High-Low Method Calculation:" FontStyle="Italic" FontSize="11" Foreground="#666" Margin="0,10,0,5"/>
                            <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#666">
                                <Run Text="Variable Cost per Unit = (Cost at High Activity - Cost at Low Activity) ÷ (High Activity Units - Low Activity Units)"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Result Display -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                        <TextBlock Text="Variable Cost Per Unit = " FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock x:Name="VariableCostPerUnitResult" Text="R 0.00" FontSize="20" FontWeight="Bold" Foreground="#1565C0" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Cost Equation Summary -->
            <Border Grid.Row="4" BorderBrush="#FF9800" BorderThickness="2" Padding="20" Background="#FFF3E0" Visibility="{Binding ElementName=CostEquationPanel, Path=Visibility}">
                <StackPanel x:Name="CostEquationPanel" Visibility="Collapsed">
                    <TextBlock Text="Total Cost Equation" FontSize="18" FontWeight="Bold" Foreground="#F57C00" Margin="0,0,0,15"/>

                    <Border Background="White" Padding="15" BorderBrush="#FF9800" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Cost Equation:" FontWeight="Bold" FontSize="14" Foreground="#F57C00" Margin="0,0,0,10"/>
                            <TextBlock x:Name="CostEquationText" TextWrapping="Wrap" FontFamily="Consolas" FontSize="14" Foreground="#333" HorizontalAlignment="Center"/>
                            <TextBlock Text="Where Q = Number of Units" FontStyle="Italic" FontSize="11" Foreground="#666" Margin="0,10,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>