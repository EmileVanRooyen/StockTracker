<UserControl x:Class="StockTracker.Views.LabourCalculation"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:StockTracker.Views"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1400">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- PHASE 1: SALES BUDGET -->
            <TextBlock Grid.Row="0" Text="Phase 1: Sales Budget Calculation" FontSize="24" FontWeight="Bold" Margin="0,0,0,10" Foreground="#1976D2"/>
            <TextBlock Grid.Row="0" Text="Calculate expected sales revenue for each product" FontSize="12" Foreground="#555" Margin="0,35,0,20"/>

            <!-- Action Buttons -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                <Button Content="Add Product" Click="AddRow_Click" Padding="10,5" Margin="0,0,10,0"/>
                <Button Content="Remove Selected" Click="RemoveRow_Click" Padding="10,5" Margin="0,0,10,0"/>
                <Button Content="Toggle Input Form" Click="ViewSummary_Click" Padding="10,5"/>
            </StackPanel>

            <!-- Step-by-Step Input Section -->
            <Border Grid.Row="2" BorderBrush="#DDD" BorderThickness="1" Padding="15" Margin="0,0,0,10" Background="#F9F9F9">
                <Grid x:Name="InputPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Step 1: Product Name -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Step 1: Product" FontWeight="Bold" VerticalAlignment="Center" Margin="0,5"/>
                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="ProductNameInput" Margin="5" Padding="5"/>

                    <!-- Step 2: Units Expected to Sell -->
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Step 2: Units to Sell" FontWeight="Bold" VerticalAlignment="Center" Margin="0,5"/>
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="5">
                        <TextBox x:Name="UnitsQuantityInput" Width="150" Margin="0,0,10,0" Padding="5" TextChanged="PriceInput_TextChanged"/>
                        <ComboBox x:Name="UnitsTypeInput" Width="150" SelectedIndex="0">
                            <ComboBoxItem Content="boxes"/>
                            <ComboBoxItem Content="packets"/>
                            <ComboBoxItem Content="units"/>
                            <ComboBoxItem Content="kg"/>
                            <ComboBoxItem Content="liters"/>
                            <ComboBoxItem Content="tons"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- Step 3: Bulk Price Input -->
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Step 3: Price" FontWeight="Bold" VerticalAlignment="Top" Margin="0,5"/>
                    <StackPanel Grid.Row="2" Grid.Column="1" Margin="5">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="R" VerticalAlignment="Center" Margin="0,0,5,0" FontWeight="SemiBold"/>
                            <TextBox x:Name="BulkPriceInput" Width="120" Padding="5" TextChanged="PriceInput_TextChanged"/>
                            <TextBlock Text="for" VerticalAlignment="Center" Margin="10,0,10,0"/>
                            <TextBox x:Name="BulkUnitsInput" Width="80" Padding="5" Text="1" TextChanged="PriceInput_TextChanged"/>
                            <TextBlock Text="unit(s)" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                        <TextBlock x:Name="PricePerUnitCalculated" 
                                   Text="Price per unit: R 0.00" 
                                   FontSize="12" 
                                   FontStyle="Italic" 
                                   Foreground="#666"
                                   Margin="0,0,0,0"/>
                    </StackPanel>

                    <!-- Step 4: Calculated Total -->
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Step 4: Total Sales (R)" FontWeight="Bold" VerticalAlignment="Center" Margin="0,5"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="CalculatedTotalDisplay" Text="R 0.00" FontSize="18" FontWeight="Bold" Foreground="#2E7D32" Margin="5" VerticalAlignment="Center"/>

                    <!-- Action Button -->
                    <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="5,15,5,5">
                        <Button Content="Add to Table" Click="AddToTable_Click" Padding="15,8" Background="#1976D2" Foreground="White" Margin="0,0,10,0"/>
                        <Button Content="Clear" Click="ClearInputs_Click" Padding="15,8"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Sales Budget Data Grid -->
            <DataGrid Grid.Row="3" 
                      x:Name="LabourDataGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      SelectionMode="Single"
                      GridLinesVisibility="All"
                      RowBackground="White"
                      AlternatingRowBackground="#F5F5F5"
                      HeadersVisibility="All"
                      FontSize="13"
                      MaxHeight="250">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Product" Binding="{Binding ProductName}" Width="2*" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Padding" Value="10,5"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Units" Binding="{Binding UnitsDisplay}" Width="2*" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Padding" Value="10,5"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Price per Unit" Binding="{Binding PricePerUnitDisplay}" Width="*" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="Padding" Value="10,5"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Total Sales (R)" Binding="{Binding TotalSalesDisplay}" Width="*" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Foreground" Value="#2E7D32"/>
                                <Setter Property="Padding" Value="10,5"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Sales Budget Summary -->
            <Border Grid.Row="4" BorderBrush="#333" BorderThickness="2" Padding="15" Margin="0,10,0,20" Background="#2C2C2C">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Total" FontSize="18" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" Padding="10,5"/>
                    <TextBlock Grid.Column="1" Text="–" FontSize="18" FontWeight="Bold" Foreground="White" HorizontalAlignment="Left" VerticalAlignment="Center" Padding="10,5"/>
                    <TextBlock Grid.Column="2" Text="–" FontSize="18" FontWeight="Bold" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="10,5"/>
                    <TextBlock Grid.Column="3" x:Name="TotalSalesText" Text="0" FontSize="18" FontWeight="Bold" Foreground="#4CAF50" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="10,5"/>
                </Grid>
            </Border>

            <!-- PHASE 2: DIRECT LABOUR BUDGET -->
            <Separator Grid.Row="5" Margin="0,20,0,20" Height="2" Background="#CCC"/>

            <TextBlock Grid.Row="6" Text="Phase 2: Direct Labour Budget" FontSize="24" FontWeight="Bold" Margin="0,0,0,10" Foreground="#D32F2F"/>
            <TextBlock Grid.Row="6" Text="Calculate labour hours and costs based on productivity rates and wage rates per product" FontSize="12" Foreground="#555" Margin="0,35,0,20"/>

            <!-- Labour Budget Input Section -->
            <Border Grid.Row="7" BorderBrush="#DDD" BorderThickness="1" Padding="15" Margin="0,0,0,10" Background="#FFF3E0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Step 1: Enter Productivity Rates and Wage Rates per Product" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>

                    <!-- Dynamic Productivity and Wage Input -->
                    <StackPanel Grid.Row="1" x:Name="ProductivityInputPanel" Margin="0,0,0,15"/>

                    <!-- Calculate Button -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                        <Button Content="Calculate Labour Budget" Click="CalculateLabourBudget_Click" Padding="15,8" Background="#D32F2F" Foreground="White"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Labour Budget Result Table -->
            <Border Grid.Row="8" BorderBrush="#333" BorderThickness="2" Padding="0" Margin="0,0,0,10">
                <Grid x:Name="LabourBudgetTable">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Dynamic columns will be added programmatically -->
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>