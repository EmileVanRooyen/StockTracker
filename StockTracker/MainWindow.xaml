<Window x:Class="StockTracker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:StockTracker"
        mc:Ignorable="d"
        Title="FIFO Stock Tracker" Height="650" Width="1250">
    <Window.Resources>
        <!-- DataGrid Header Style -->
        <Style x:Key="DataGridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#2C3E50"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="#34495E"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <!-- Received Section Header Style -->
        <Style x:Key="ReceivedHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource DataGridHeaderStyle}">
            <Setter Property="Background" Value="#27AE60"/>
        </Style>

        <!-- Issued Section Header Style -->
        <Style x:Key="IssuedHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource DataGridHeaderStyle}">
            <Setter Property="Background" Value="#E74C3C"/>
        </Style>

        <!-- Balance Section Header Style -->
        <Style x:Key="BalanceHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource DataGridHeaderStyle}">
            <Setter Property="Background" Value="#3498DB"/>
        </Style>

        <!-- Date Header Style -->
        <Style x:Key="DateHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource DataGridHeaderStyle}">
            <Setter Property="Background" Value="#34495E"/>
        </Style>

        <!-- Type Header Style -->
        <Style x:Key="TypeHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource DataGridHeaderStyle}">
            <Setter Property="Background" Value="#95A5A6"/>
        </Style>

        <!-- Base DataGrid Cell Style -->
        <Style x:Key="BaseDataGridCellStyle" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="BorderBrush" Value="#BDC3C7"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#D5DBDB"/>
                    <Setter Property="Foreground" Value="Black"/>
                    <Setter Property="BorderBrush" Value="#95A5A6"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Cell Styles for Each Section -->
        <Style x:Key="DateCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource BaseDataGridCellStyle}">
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style x:Key="ReceivedCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource BaseDataGridCellStyle}">
            <Setter Property="Background" Value="#E8F8F5"/>
        </Style>

        <Style x:Key="IssuedCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource BaseDataGridCellStyle}">
            <Setter Property="Background" Value="#FADBD8"/>
        </Style>

        <Style x:Key="BalanceCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource BaseDataGridCellStyle}">
            <Setter Property="Background" Value="#EBF5FB"/>
        </Style>

        <Style x:Key="TypeCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource BaseDataGridCellStyle}">
            <Setter Property="Background" Value="#F8F9F9"/>
        </Style>

        <!-- Text Block Styles -->
        <Style x:Key="CenterAlignedText" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>

        <Style x:Key="RightAlignedText" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8,6,12,6"/>
        </Style>

        <Style x:Key="LeftAlignedText" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="12,6,8,6"/>
        </Style>

        <Style x:Key="BoldRightAlignedText" TargetType="TextBlock" BasedOn="{StaticResource RightAlignedText}">
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="BoldCenterAlignedText" TargetType="TextBlock" BasedOn="{StaticResource CenterAlignedText}">
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Panel - Input Forms -->
        <Border Grid.Column="0" BorderBrush="LightGray" BorderThickness="1" CornerRadius="5" Padding="10">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="FIFO Stock Tracker" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>

                    <!-- Opening Balance Section -->
                    <GroupBox Header="Opening Balance" Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="Date:" Margin="0,5,0,2"/>
                            <DatePicker x:Name="dpOpeningDate" Height="25"/>
                            <TextBlock Text="Units:" Margin="0,5,0,2"/>
                            <TextBox x:Name="txtOpeningUnits" Height="25"/>
                            <TextBlock Text="Price per Unit (R):" Margin="0,5,0,2"/>
                            <TextBox x:Name="txtOpeningPrice" Height="25"/>
                            <Button x:Name="btnAddOpening" Content="Add Opening Balance" 
                                    Height="30" Margin="0,10,0,0" Click="BtnAddOpening_Click"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- Purchase Section -->
                    <GroupBox Header="Purchase Stock" Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="Date:" Margin="0,5,0,2"/>
                            <DatePicker x:Name="dpPurchaseDate" Height="25"/>
                            <TextBlock Text="Units:" Margin="0,5,0,2"/>
                            <TextBox x:Name="txtPurchaseUnits" Height="25"/>
                            <TextBlock Text="Price per Unit (R):" Margin="0,5,0,2"/>
                            <TextBox x:Name="txtPurchasePrice" Height="25"/>
                            <Button x:Name="btnPurchase" Content="Purchase" 
                                    Height="30" Margin="0,10,0,0" Click="BtnPurchase_Click"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- Return Section -->
                    <GroupBox Header="Return Stock" Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="Date:" Margin="0,5,0,2"/>
                            <DatePicker x:Name="dpReturnDate" Height="25"/>
                            <TextBlock Text="Select Batch to Return From:" Margin="0,5,0,2"/>
                            <ComboBox x:Name="cmbReturnBatch" Height="25" 
                                      SelectionChanged="CmbReturnBatch_SelectionChanged"
                                      DisplayMemberPath="DisplayText"/>
                            <TextBlock Text="Units to Return:" Margin="0,5,0,2"/>
                            <TextBox x:Name="txtReturnUnits" Height="25"/>
                            <TextBlock x:Name="txtReturnBatchInfo" 
                                       Margin="0,5,0,0" 
                                       Foreground="DarkBlue"
                                       TextWrapping="Wrap"
                                       FontSize="11"/>
                            <Button x:Name="btnReturn" Content="Return from Selected Batch" 
                                    Height="30" Margin="0,10,0,0" Click="BtnReturn_Click"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- Sell Section -->
                    <GroupBox Header="Sell/Issue Stock" Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="Date:" Margin="0,5,0,2"/>
                            <DatePicker x:Name="dpSellDate" Height="25"/>
                            <TextBlock Text="Units to Sell/Issue:" Margin="0,5,0,2"/>
                            <TextBox x:Name="txtSellUnits" Height="25"/>
                            <TextBlock Text="Selling Price per Unit (R) - Optional:" Margin="0,5,0,2"/>
                            <TextBox x:Name="txtSellingPrice" Height="25" 
                                     ToolTip="Leave empty if price is unknown"/>
                            <TextBlock Text="(Leave price empty if unknown)" 
                                       FontSize="10" Foreground="Gray" Margin="0,2,0,0"/>
                            <Button x:Name="btnSell" Content="Sell/Issue (FIFO)" 
                                    Height="30" Margin="0,10,0,0" Click="BtnSell_Click"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- Current Summary -->
                    <Border Background="#F0F0F0" Padding="10" CornerRadius="3" Margin="0,10,0,10">
                        <StackPanel>
                            <TextBlock Text="Current Stock Summary" FontWeight="Bold" Margin="0,0,0,5"/>
                            <TextBlock x:Name="txtCurrentUnits" Text="Total Units: 0"/>
                            <TextBlock x:Name="txtAverageCost" Text="Average Cost: R0.00"/>
                            <TextBlock x:Name="txtTotalBatches" Text="Batches: 0" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Start Over Button -->
                    <Button x:Name="btnStartOver" Content="Start Over" 
                            Height="35" Background="#FFCCCB" Click="BtnStartOver_Click"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Right Panel - Transaction Table -->
        <Border Grid.Column="1" BorderBrush="#2C3E50" BorderThickness="2" CornerRadius="5" Padding="0" Margin="10,0,0,0" Background="White">
            <DockPanel>
                <Border DockPanel.Dock="Top" Background="#34495E" Padding="10" CornerRadius="3,3,0,0">
                    <TextBlock Text="Transaction History" FontSize="18" FontWeight="Bold" 
                               Foreground="White" HorizontalAlignment="Center"/>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Section Headers Row -->
                        <Border Grid.Row="0" Background="#2C3E50" Height="35" BorderBrush="#34495E" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="210"/>
                                    <ColumnDefinition Width="210"/>
                                    <ColumnDefinition Width="210"/>
                                    <ColumnDefinition Width="*" MinWidth="150"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="" FontWeight="Bold" Foreground="White" 
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                <Border Grid.Column="1" Background="#27AE60">
                                    <TextBlock Text="RECEIVED" FontWeight="Bold" Foreground="White" FontSize="13"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <Border Grid.Column="2" Background="#E74C3C">
                                    <TextBlock Text="ISSUED" FontWeight="Bold" Foreground="White" FontSize="13"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <Border Grid.Column="3" Background="#3498DB">
                                    <TextBlock Text="BALANCE" FontWeight="Bold" Foreground="White" FontSize="13"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <Border Grid.Column="4" Background="#95A5A6">
                                    <TextBlock Text="" FontWeight="Bold" Foreground="White" FontSize="13"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- DataGrid -->
                        <DataGrid Grid.Row="1" x:Name="dgTransactions" 
                                  AutoGenerateColumns="False" 
                                  IsReadOnly="True"
                                  GridLinesVisibility="All"
                                  HeadersVisibility="Column"
                                  CanUserResizeColumns="False"
                                  CanUserSortColumns="False"
                                  CanUserReorderColumns="False"
                                  RowBackground="White"
                                  AlternatingRowBackground="White"
                                  BorderThickness="0"
                                  HorizontalGridLinesBrush="#BDC3C7"
                                  VerticalGridLinesBrush="#BDC3C7"
                                  FontSize="11"
                                  RowHeight="36"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Disabled">
                            <DataGrid.Columns>
                                <!-- Date Column -->
                                <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat=yyyy-MM-dd}" Width="100">
                                    <DataGridTextColumn.HeaderStyle>
                                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DateHeaderStyle}"/>
                                    </DataGridTextColumn.HeaderStyle>
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource BoldCenterAlignedText}"/>
                                    </DataGridTextColumn.ElementStyle>
                                    <DataGridTextColumn.CellStyle>
                                        <Style TargetType="DataGridCell" BasedOn="{StaticResource DateCellStyle}"/>
                                    </DataGridTextColumn.CellStyle>
                                </DataGridTextColumn>

                                <!-- Received Section -->
                                <DataGridTextColumn Header="Units" Binding="{Binding ReceivedUnits}" Width="70">
                                    <DataGridTextColumn.HeaderStyle>
                                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource ReceivedHeaderStyle}"/>
                                    </DataGridTextColumn.HeaderStyle>
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource RightAlignedText}"/>
                                    </DataGridTextColumn.ElementStyle>
                                    <DataGridTextColumn.CellStyle>
                                        <Style TargetType="DataGridCell" BasedOn="{StaticResource ReceivedCellStyle}"/>
                                    </DataGridTextColumn.CellStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Price" Binding="{Binding ReceivedPrice}" Width="70">
                                    <DataGridTextColumn.HeaderStyle>
                                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource ReceivedHeaderStyle}"/>
                                    </DataGridTextColumn.HeaderStyle>
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource RightAlignedText}"/>
                                    </DataGridTextColumn.ElementStyle>
                                    <DataGridTextColumn.CellStyle>
                                        <Style TargetType="DataGridCell" BasedOn="{StaticResource ReceivedCellStyle}"/>
                                    </DataGridTextColumn.CellStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Amount" Binding="{Binding ReceivedAmount}" Width="70">
                                    <DataGridTextColumn.HeaderStyle>
                                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource ReceivedHeaderStyle}"/>
                                    </DataGridTextColumn.HeaderStyle>
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource BoldRightAlignedText}"/>
                                    </DataGridTextColumn.ElementStyle>
                                    <DataGridTextColumn.CellStyle>
                                        <Style TargetType="DataGridCell" BasedOn="{StaticResource ReceivedCellStyle}"/>
                                    </DataGridTextColumn.CellStyle>
                                </DataGridTextColumn>

                                <!-- Issued Section -->
                                <DataGridTextColumn Header="Units" Binding="{Binding IssuedUnits}" Width="70">
                                    <DataGridTextColumn.HeaderStyle>
                                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource IssuedHeaderStyle}"/>
                                    </DataGridTextColumn.HeaderStyle>
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource RightAlignedText}"/>
                                    </DataGridTextColumn.ElementStyle>
                                    <DataGridTextColumn.CellStyle>
                                        <Style TargetType="DataGridCell" BasedOn="{StaticResource IssuedCellStyle}"/>
                                    </DataGridTextColumn.CellStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Price" Binding="{Binding IssuedPrice}" Width="70">
                                    <DataGridTextColumn.HeaderStyle>
                                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource IssuedHeaderStyle}"/>
                                    </DataGridTextColumn.HeaderStyle>
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource RightAlignedText}"/>
                                    </DataGridTextColumn.ElementStyle>
                                    <DataGridTextColumn.CellStyle>
                                        <Style TargetType="DataGridCell" BasedOn="{StaticResource IssuedCellStyle}"/>
                                    </DataGridTextColumn.CellStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Amount" Binding="{Binding IssuedAmount}" Width="70">
                                    <DataGridTextColumn.HeaderStyle>
                                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource IssuedHeaderStyle}"/>
                                    </DataGridTextColumn.HeaderStyle>
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource BoldRightAlignedText}"/>
                                    </DataGridTextColumn.ElementStyle>
                                    <DataGridTextColumn.CellStyle>
                                        <Style TargetType="DataGridCell" BasedOn="{StaticResource IssuedCellStyle}"/>
                                    </DataGridTextColumn.CellStyle>
                                </DataGridTextColumn>

                                <!-- Balance Section -->
                                <DataGridTextColumn Header="Units" Binding="{Binding BalanceUnits}" Width="70">
                                    <DataGridTextColumn.HeaderStyle>
                                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource BalanceHeaderStyle}"/>
                                    </DataGridTextColumn.HeaderStyle>
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource RightAlignedText}"/>
                                    </DataGridTextColumn.ElementStyle>
                                    <DataGridTextColumn.CellStyle>
                                        <Style TargetType="DataGridCell" BasedOn="{StaticResource BalanceCellStyle}"/>
                                    </DataGridTextColumn.CellStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Price" Binding="{Binding BalancePrice}" Width="70">
                                    <DataGridTextColumn.HeaderStyle>
                                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource BalanceHeaderStyle}"/>
                                    </DataGridTextColumn.HeaderStyle>
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource RightAlignedText}"/>
                                    </DataGridTextColumn.ElementStyle>
                                    <DataGridTextColumn.CellStyle>
                                        <Style TargetType="DataGridCell" BasedOn="{StaticResource BalanceCellStyle}"/>
                                    </DataGridTextColumn.CellStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Amount" Binding="{Binding BalanceAmount}" Width="70">
                                    <DataGridTextColumn.HeaderStyle>
                                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource BalanceHeaderStyle}"/>
                                    </DataGridTextColumn.HeaderStyle>
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource BoldRightAlignedText}"/>
                                    </DataGridTextColumn.ElementStyle>
                                    <DataGridTextColumn.CellStyle>
                                        <Style TargetType="DataGridCell" BasedOn="{StaticResource BalanceCellStyle}"/>
                                    </DataGridTextColumn.CellStyle>
                                </DataGridTextColumn>

                                <!-- Type Column -->
                                <DataGridTextColumn Header="Type" Binding="{Binding TransactionType}" Width="*" MinWidth="150">
                                    <DataGridTextColumn.HeaderStyle>
                                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource TypeHeaderStyle}"/>
                                    </DataGridTextColumn.HeaderStyle>
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource LeftAlignedText}">
                                            <Setter Property="TextWrapping" Value="NoWrap"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                    <DataGridTextColumn.CellStyle>
                                        <Style TargetType="DataGridCell" BasedOn="{StaticResource TypeCellStyle}"/>
                                    </DataGridTextColumn.CellStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</Window>